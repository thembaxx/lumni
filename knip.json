{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/app/**/page.tsx", "src/app/**/layout.tsx", "src/app/**/route.ts"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/hooks/__tests__/test-utils.tsx",
    "src/lib/server/__tests__/setup.ts",
    "src/lib/z-integration/integration.int-test.ts",
    "src/lib/caching-strategy/index.ts"
  ],

  "ignoreDependencies": [
    "@types/katex",
    "react-day-picker",
    "sharp",
    "tailwind-scrollbar-hide",
    "tw-animate-css"
  ],
  "rules": {
    "files": "off",
    "dependencies": "warn",
    "unlisted": "warn",
    "devDependencies": "off",
    "exports": "warn",
    "types": "warn",
    "nsExports": "warn",
    "nsTypes": "warn",
    "duplicates": "warn",
    "enumMembers": "warn"
  }
}
