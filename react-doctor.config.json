{
  "$schema": "https://react.doctor/schema/config.json",
  "rules": {
    "react-doctor/prefer-useReducer": "off",
    "react-doctor/no-giant-component": "off",
    "react-doctor/no-locale-format-in-render": "off",
    "react-doctor/client-localstorage-no-version": "off",
    "react-doctor/no-derived-state": "off",
    "react-doctor/query-mutation-missing-invalidation": "off",
    "react-doctor/query-no-usequery-for-mutation": "off",
    "react-doctor/no-adjust-state-on-prop-change": "off",
    "react-doctor/prefer-use-sync-external-store": "off",
    "react-doctor/no-derived-useState": "off",
    "react-doctor/button-has-type": "off",
    "react-doctor/nextjs-no-img-element": "off",
    "react-doctor/nextjs-no-client-side-redirect": "off",
    "react-doctor/html-no-nested-interactive": "off",
    "react-doctor/no-barrel-import": "off",
    "react-doctor/async-parallel": "off",
    "react-doctor/js-length-check-first": "off",
    "react-doctor/insecure-crypto-risk": "off",
    "react-doctor/unsafe-json-in-html": "off",
    "react-doctor/role-supports-aria-props": "off",
    "react-doctor/control-has-associated-label": "off",
    "react-doctor/no-redundant-roles": "off",
    "react-doctor/label-has-associated-control": "off",
    "react-doctor/js-combine-iterations": "off",
    "react-doctor/js-flatmap-filter": "off",
    "react-doctor/js-hoist-intl": "off",
    "react-doctor/js-set-map-lookups": "off",
    "react-doctor/no-array-index-as-key": "off",
    "react-doctor/prefer-dynamic-import": "off",
    "react-doctor/rerender-memo-before-early-return": "off",
    "react-doctor/rerender-state-only-in-handlers": "off",
    "react-doctor/no-fetch-in-effect": "off",
    "react-doctor/no-match-media-in-state-initializer": "off",
    "react-doctor/rendering-hydration-mismatch-time": "off",
    "react-doctor/rendering-hydration-no-flicker": "off",
    "react-doctor/no-inline-bounce-easing": "off",
    "react-doctor/use-lazy-motion": "off",
    "react-doctor/no-derive-from-url": "off",
    "react-doctor/zod-v4-prefer-top-level-string-formats": "off",
    "react-doctor/server-sequential-independent-await": "off",
    "react-doctor/server-auth-actions": "off",
    "react-doctor/query-stable-query-client": "off",
    "react-doctor/no-derived-state-effect": "off",
    "react-doctor/effect-needs-cleanup": "off",
    "react-doctor/no-impure-state-updater": "off",
    "react-doctor/no-initialize-state": "off",
    "react-doctor/no-event-handler": "off",
    "react-doctor/prefer-tag-over-role": "off",
    "react-doctor/interactive-supports-focus": "off",
    "react-doctor/no-cascading-set-state": "off",
    "react-doctor/dangerous-html-sink": "off",
    "react-doctor/react-compiler-no-manual-memoization": "off"
  },
  "ignore": {
    "rules": [
      "deslop/unused-file",
      "deslop/unused-export",
      "react-doctor/nextjs-missing-metadata",
      "react-doctor/no-multi-comp",
      "react-doctor/only-export-components",
      "react-doctor/prefer-module-scope-pure-function",
      "react-doctor/async-await-in-loop",
      "socket/low-supply-chain-score",
      "react-hooks-js/todo",
      "react-hooks-js/refs",
      "react-hooks-js/set-state-in-effect",
      "react-hooks-js/purity",
      "react-hooks-js/hooks",
      "react-hooks-js/rules-of-hooks",
      "eslint/no-unused-vars",
      "typescript/no-explicit-any",
      "deslop/unused-dependency",
      "deslop/unused-dev-dependency"
    ],
    "overrides": [
      {
        "files": [".agents/**"],
        "rules": ["eslint/no-unused-vars", "eslint/no-shadow"]
      },
      {
        "files": [".agents/skills/impeccable/scripts/modern-screenshot.umd.js"],
        "rules": ["react-doctor/iframe-missing-sandbox"]
      },
      {
        "files": ["src/app/api/gamification/__tests__/route.test.ts"],
        "rules": ["react-doctor/no-this-in-sfc"]
      },
      {
        "files": ["src/app/api/payfast/notify/route.ts"],
        "rules": ["react-doctor/insecure-crypto-risk"]
      },
      {
        "files": [".github/workflows/ci.yml"],
        "rules": ["react-doctor/build-pipeline-secret-boundary"]
      },
      {
        "files": ["pnpm-workspace.yaml"],
        "rules": ["react-doctor/require-pnpm-hardening"]
      }
    ]
  }
}
