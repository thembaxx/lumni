{
	"$schema": "https://react.doctor/schema/config.json",
	"rules": {
		"react-doctor/prefer-useReducer": "off",
		"react-doctor/no-giant-component": "off"
	},
	"ignore": {
		"rules": ["deslop/unused-file", "react-doctor/nextjs-missing-metadata"],
		"overrides": [
			{
				"files": ["src/components/onboarding/particle-field.tsx"],
				"rules": ["react-doctor/no-unknown-property"]
			},
			{
				"files": [
					"src/app/layout.tsx",
					"src/app/[locale]/layout.tsx",
					"src/components/ui/safe-html.tsx",
					"src/components/ui/chart.tsx"
				],
				"rules": ["react-doctor/no-danger"]
			},
			{
				"files": ["package.json"],
				"rules": ["deslop/unused-dependency", "deslop/unused-dev-dependency"]
			},
			{
				"files": ["src/components/quiz/hooks/use-quiz-view.ts"],
				"rules": [
					"react-doctor/no-event-handler",
					"react-doctor/exhaustive-deps"
				]
			},
			{
				"files": ["src/components/dashboard/daily-bolt-overlay.tsx"],
				"rules": [
					"react-doctor/no-event-handler",
					"react-doctor/no-chain-state-updates"
				]
			},
			{
				"files": [
					"src/components/ui/live-waveform/canvas-component.tsx",
					"src/components/dashboard/search/search-results.tsx"
				],
				"rules": ["react-doctor/prefer-tag-over-role"]
			},
			{
				"files": ["src/hooks/use-scroll-reveal.ts"],
				"rules": ["react-doctor/no-initialize-state"]
			},
			{
				"files": ["src/lib/z-integration/integration.int-test.ts"],
				"rules": ["react-doctor/server-sequential-independent-await"]
			},
			{
				"files": ["src/lib/premium/premium-context.tsx"],
				"rules": [
					"react-doctor/no-event-handler",
					"react-doctor/no-chain-state-updates",
					"react-doctor/no-effect-chain",
					"react-doctor/query-no-usequery-for-mutation"
				]
			},
			{
				"files": [".agents/skills/impeccable/scripts/modern-screenshot.umd.js"],
				"rules": ["react-doctor/iframe-missing-sandbox"]
			}
		]
	}
}
