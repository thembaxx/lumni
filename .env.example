# ─── OpenTelemetry (AI SDK spans + tracing) ──────────────
# Set to "true" to disable all OTel exports (spans still captured in-process)
OTEL_SDK_DISABLED=false
# OTLP HTTP endpoint for trace export (default: http://localhost:4318/v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Comma-separated key=value pairs for OTLP auth, e.g. "Authorization=Bearer xyz"
OTEL_EXPORTER_OTLP_HEADERS=
# Service name reported in exported spans (default: lumni)
OTEL_SERVICE_NAME=

# ─── AI Providers ───────────────────────────────────────
