      "id": "phys_001",
      "topic": "Newton's Laws of Motion",
      "difficulty": "Easy",
      "points": 10,
      "questionText": "A 5 kg box is pushed across a frictionless horizontal surface with a force of 20 N. What is the acceleration of the box?",
      "questionType": "multiple-choice",
      "options": [
        { "id": "A", "text": "4 m/s²", "isCorrect": true },
        { "id": "B", "text": "2 m/s²", "isCorrect": false },
        { "id": "C", "text": "10 m/s²", "isCorrect": false },
        { "id": "D", "text": "100 m/s²", "isCorrect": false }
      ],
      "supportsDiagram": true,
      "diagram": {
        "type": "force-vector",
        "title": "Box on Horizontal Surface",
        "data": {
          "showForces": [
            { "label": "F = 20 N", "direction": "right", "color": "#3b82f6", "origin": "center-right" },
            { "label": "mg = 49 N", "direction": "down", "color": "#ef4444", "origin": "bottom-center" },
            { "label": "N = 49 N", "direction": "up", "color": "#22c55e", "origin": "top-center" }
          ],
          "objects": [
            { "type": "rectangle", "x": 150, "y": 120, "width": 80, "height": 50, "fill": "#6366f1", "label": "5 kg" }
          ]
        }
      },
      "hint": "Apply Newton's Second Law: F = ma. Solve for a = F/m",
      "explanation": "Using F = ma: a = F/m = 20 N / 5 kg = 4 m/s². The correct answer is 4 m/s²."
    },
