	{
		"id": "econ_065",
		"topic": "Micro-economics: Market Structures",
		"difficulty": "Hard",
		"points": 20,
		"questionText": "According to the Kinked Demand Curve diagram for an Oligopoly, why are prices often rigid?",
		"questionType": "multiple-choice",
		"options": [
			{
				"id": "A",
				"text": "Competitors will follow price cuts but not price increases.",
				"isCorrect": true
			},
			{
				"id": "B",
				"text": "Competitors will follow all price changes.",
				"isCorrect": false
			},
			{
				"id": "C",
				"text": "Government sets a fixed price.",
				"isCorrect": false
			},
			{ "id": "D", "text": "Demand is perfectly elastic.", "isCorrect": false }
		],
		"supportsDiagram": true,
		"diagram": {
			"type": "node-flow",
			"data": {
				"nodes": [
					{
						"id": "p",
						"type": "point",
						"label": "Price (P)",
						"x": 50,
						"y": 100
					},
					{
						"id": "ela",
						"type": "curve",
						"label": "Elastic (Above P)",
						"x": 150,
						"y": 20
					},
					{
						"id": "ine",
						"type": "curve",
						"label": "Inelastic (Below P)",
						"x": 250,
						"y": 180
					}
				],
				"edges": [
					{ "id": "e1", "source": "ela", "target": "p" },
					{ "id": "e2", "source": "p", "target": "ine" }
				]
			}
		},
		"hint": "Behavioral asymmetry among competitors.",
		"explanation": "In an oligopoly, if a firm raises its price, others won't follow (losing market share). If it lowers price, others follow (no gain in share), leading to price stability."
	},
