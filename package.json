    "nm:check": "knip --no-exit-code",
    "gate": "pnpm run lint:fix && pnpm run format && pnpm run typecheck && pnpm run test && pnpm run nm:check",
    "validate:metrics": "tsx scripts/validate-metrics.ts",
    "validate:ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run validate:metrics"
