		"test": "vitest run",
		"test:watch": "vitest",
		"test:int": "vitest run ./src/lib/z-integration/integration.int-test.ts",
		"test:all": "vitest run",
		"database:ensure": "npx tsx scripts/ensure-appwrite.ts",
		"admin:create": "npx tsx scripts/create-admin.ts",
		"test:e2e": "npx playwright test",
		"test:e2e:ui": "npx playwright test --ui",
		"typecheck": "tsc --noEmit",
		"deadcode": "knip --no-exit-code",
		"postinstall": "patch-package",
		"prepare": "husky",
		"analyze": "ANALYZE=true next build",
		"todo:sync": "npx tsx scripts/sync-todo-to-linear.ts",
