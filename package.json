	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "npx @biomejs/biome check .",
		"lint:fix": "npx @biomejs/biome check --write .",
		"format": "npx @biomejs/biome format --write .",
		"db:migrate": "npx tsx src/lib/db/migrate.ts",
		"db:sync": "npx tsx src/lib/db/sync/cli.ts",
		"db:ensure": "npx tsx scripts/ensure-appwrite.ts",
